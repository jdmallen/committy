<Project>

	<PropertyGroup>
		<!--
		     Single source of truth for the version, applied to every project in the
		     solution (app and tests). publish.sh and the release workflow read this
		     value (overridable via -v on publish.sh) to stamp published binaries and
		     name release archives.
		-->
		<Version>1.1.0</Version>
	</PropertyGroup>

</Project>
