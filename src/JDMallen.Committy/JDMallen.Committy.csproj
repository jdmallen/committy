<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>committy</AssemblyName>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<!-- Runs the trim and AOT analyzers in every build, not just publish. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="3.0.0"/>
		<PackageReference Include="TextCopy" Version="6.2.1"/>
		<PackageReference Include="JDMallen.Toolbox.AI" Version="4.8.0"/>
		<PackageReference Include="JDMallen.Toolbox.AI.Azure" Version="4.8.0"/>
	</ItemGroup>

	<ItemGroup>
		<!--
			The installed hook's text. HookInstaller.Trampoline reads it, and
			TrampolineTests pins its hash, since every installed hook is
			compared against it.
		-->
		<EmbeddedResource Include="..\..\hooks\prepare-commit-msg" LogicalName="prepare-commit-msg"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Chat client types (IChatCompletionClient et al.) used throughout. -->
		<Using Include="JDMallen.Toolbox.AI"/>
	</ItemGroup>

	<!--
		The SDK appends the full 40-character commit hash to the informational
		version, which committy's version and info output print. Keep
		git's usual 7-character short hash instead (1.11.0+3186e64). Runs after
		the SDK reads the commit from git and before the version attribute is
		generated.
	-->
	<Target Name="ShortenSourceRevisionId"
			AfterTargets="InitializeSourceControlInformation"
			Condition="'$(SourceRevisionId.Length)' &gt; '7'">
		<PropertyGroup>
			<SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
		</PropertyGroup>
	</Target>

</Project>
