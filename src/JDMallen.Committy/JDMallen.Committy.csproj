<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>committy</AssemblyName>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
		<!-- Runs the trim and AOT analyzers in every build, not just publish. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="3.0.0"/>
		<PackageReference Include="TextCopy" Version="6.2.1"/>
		<PackageReference Include="JDMallen.Toolbox.AI" Version="4.8.0"/>
		<PackageReference Include="JDMallen.Toolbox.AI.Azure" Version="4.8.0"/>
	</ItemGroup>

	<ItemGroup>
		<!-- Chat client types (IChatCompletionClient et al.) used throughout. -->
		<Using Include="JDMallen.Toolbox.AI"/>
	</ItemGroup>

</Project>
